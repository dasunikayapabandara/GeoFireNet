# Application Environment
ENVIRONMENT=development
SIMULATE_OUTAGE=False
WEATHER_API_KEY=

# Database Configuration
# You can define individual components:
db_host=localhost
db_port=5432
db_user=dasunika
db_password=geofirenet_dev
db_name=geofirenet_db
# OR define the full DATABASE_URL directly:
# DATABASE_URL=postgresql://dasunika:geofirenet_dev@localhost:5432/geofirenet_db

# Model and Data Paths (Absolute or Relative to backend/)
# ARTIFACTS_DIR=artifacts
# MODEL_PATH=artifacts/model.pkl
# DATASET_PATH=data/dataset.csv

# Alert Thresholds (0-100 scale)
ALERT_EXTREME_THRESHOLD=90.0
ALERT_HIGH_THRESHOLD=75.0
ALERT_MODERATE_THRESHOLD=50.0

# Physical Environment Limits (Used for data scaling and mock heuristics)
MAX_TEMP=50.0
MIN_TEMP=0.0
MAX_HUMIDITY=100.0
MAX_WIND=100.0

# Fallback Penalty Thresholds
MOCK_PENALTY_TEMP=35.0
MOCK_PENALTY_WIND=60.0
